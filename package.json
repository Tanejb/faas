{
  "name": "campus-hub-faas",
  "version": "1.0.0",
  "private": true,
  "description": "CampusHub — serverless backend (Firebase FaaS) for ITA",
  "scripts": {
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "emulators:demo": "firebase emulators:start --project demo-campushub --import=./emulator-data --export-on-exit=./emulator-data",
    "emulators:clean": "firebase emulators:start",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "npm run build:web && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,storage"
  },
  "devDependencies": {
    "firebase-tools": "^13.35.1"
  },
  "engines": {
    "node": "22"
  }
}
